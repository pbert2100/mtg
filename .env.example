# Sem o prefixo NEXT_PUBLIC_: lidas em tempo de execução, não embutidas no build.
SUPABASE_URL=https://<seu-projeto>.supabase.co

# Recomendado: leitura server-side com a chave secreta (funciona com RLS fechado).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Opcional: exige policy de SELECT para o papel anon nas tabelas jogadores e partidas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
